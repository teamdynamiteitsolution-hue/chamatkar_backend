# =========================================================
# Chamatkar Backend Environment Template (.env.example)
# =========================================================

# Django Core Settings
DJANGO_SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com,api.yourdomain.com,127.0.0.1,localhost

# Database Authentication (MySQL for cPanel / PostgreSQL / SQLite)
# For cPanel Shared Hosting: DB_ENGINE=mysql
# For Local Dev: DB_ENGINE=sqlite
DB_ENGINE=mysql
DB_NAME=cpaneluser_chamatkar
DB_USER=cpaneluser_dokanuser
DB_PASSWORD=your_cpanel_db_password
DB_HOST=localhost
DB_PORT=3306
# Alternatively, use a single cloud DATABASE_URL (Neon.tech, Supabase, Render, etc.):
# DATABASE_URL=mysql://user:password@localhost:3306/dbname

# Panel & System User Credentials
ADMIN_USER=admin
ADMIN_PASS=your_admin_password
MANAGER_USER=manager
MANAGER_PASS=your_manager_password
DISPATCHER_USER=dispatcher
DISPATCHER_PASS=your_dispatcher_password
FRONT_PANEL_USER=admin
FRONT_PANEL_PASS=your_front_panel_password
COURIER_RIDER_PIN=1234
DEMO_USER_PHONE=01712345678
DEMO_USER_PASS=1234

# Artificial Intelligence (Gemini AI API)
GEMINI_API_KEY=your_gemini_api_key

# Cloudinary Media Storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret
CLOUDINARY_FOLDER=chamatkar/products

# SSLCOMMERZ Payment Gateway Credentials
# For Live: SSLCOMMERZ_IS_SANDBOX=False and use live Store ID & Password
SSLCOMMERZ_STORE_ID=your_store_id
SSLCOMMERZ_STORE_PASSWORD=your_store_password
SSLCOMMERZ_IS_SANDBOX=True
SSLCOMMERZ_FRONTEND_URL=https://yourdomain.com
SSLCOMMERZ_BACKEND_URL=https://api.yourdomain.com

# Courier Gateway API Credentials
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
REDX_API_TOKEN=
REDX_SECRET_KEY=
ECOURIER_API_KEY=
ECOURIER_SECRET_KEY=

# WhatsApp & Meta Conversions API (CAPI)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
ULTRAMSG_TOKEN=
ULTRAMSG_INSTANCE_ID=
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=

# SMTP Email Gateway (Order Confirmations, Invoices & Tracking)
# For Gmail: Use App Password from Google Account > Security > 2-Step Verification > App Passwords
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=Chamatkar BD <orders@yourdomain.com>

# Live Server URL Settings
APP_URL=https://yourdomain.com
FRONTEND_URL=https://yourdomain.com
BACKEND_URL=https://api.yourdomain.com
