# Prevent direct web access to sensitive backend files
<FilesMatch "^\.env|\.git|\.sqlite3|requirements\.txt|manage\.py">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>
